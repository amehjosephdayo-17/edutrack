PORT=5000
MONGODB_URI=mongodb://localhost:27017/edutrack
SESSION_SECRET=replace_with_long_random_string
NODE_ENV=development
COOKIE_SECURE=false

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# Session duration
SESSION_MAX_AGE_MS=1800000       # 30 minutes — standard session
REMEMBER_ME_MAX_AGE_MS=86400000  # 24 hours — remember me

# Email configuration for OTP
EMAIL_SERVICE=gmail              # Options: gmail, custom
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password # For Gmail: use App Password, not your regular password
EMAIL_FROM=noreply@edutrack.com  # Display email address (optional, defaults to EMAIL_USER)

# For custom SMTP (if EMAIL_SERVICE=custom)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

